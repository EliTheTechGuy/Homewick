{
  "name": "homewick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "member:link": "node scripts/member-login-link.mjs",
    "email:test": "tsx scripts/send-test-email.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "admin:add": "node --env-file=.env.local scripts/admin-user.mjs add",
    "admin:list": "node --env-file=.env.local scripts/admin-user.mjs list",
    "admin:password": "node --env-file=.env.local scripts/admin-user.mjs password"
  },
  "dependencies": {
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
