# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------
# Database — Supabase or Neon. Use the POOLED connection string in
# serverless, not the direct one.
# ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---------------------------------------------------------------
# Entry-code encryption.
#
# This key decrypts customers' door and gate codes. It lives here,
# outside the database, so that a Postgres dump on its own does not
# open anybody's front door. Generate with:
#
#   openssl rand -base64 32
#
# Rotating it makes existing entry codes unreadable — they would need
# re-encrypting first.
# ---------------------------------------------------------------
ACCESS_SECRET_KEY=

# ---------------------------------------------------------------
# Stripe. Card data never touches our servers; Checkout collects it.
# The webhook secret comes from the endpoint you register in Stripe,
# or from `stripe listen` in local development.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Admin. The today-view can reveal entry codes, so this must be set
# before deploying — the page refuses to render without it.
# ---------------------------------------------------------------
ADMIN_PASSWORD=

# Protects the daily cron endpoint. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# ---------------------------------------------------------------
# Public site config.
#
# NEXT_PUBLIC_CONTACT_EMAIL is deliberately unset: the address in use
# is info@homewickcleaning.com but the domain actually owned is the
# .net. Contact details do not render until this is decided.
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
