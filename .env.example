# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------
# Database — Supabase.
#
# Use the POOLED connection string, not the direct one. This is not a
# preference: Supabase's direct host (db.<ref>.supabase.co) publishes only an
# AAAA record, and Vercel's functions do not route IPv6, so the direct string
# cannot connect from production at all. It also opens one Postgres connection
# per function invocation, which exhausts the server under any real traffic.
#
# The pooled string is in Supabase under Project Settings → Database →
# Connection string → Transaction pooler. Note the username carries the
# project ref, and the port is 6543 rather than 5432:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# For this project the host is aws-0-ca-central-1.pooler.supabase.com.
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Entry-code encryption.
#
# This key decrypts customers' door and gate codes. It lives here,
# outside the database, so that a Postgres dump on its own does not
# open anybody's front door. Generate with:
#
#   openssl rand -base64 32
#
# Rotating it makes existing entry codes unreadable — they would need
# re-encrypting first.
# ---------------------------------------------------------------
ACCESS_SECRET_KEY=

# ---------------------------------------------------------------
# Stripe. Card data never touches our servers; Checkout collects it.
# The webhook secret comes from the endpoint you register in Stripe,
# or from `stripe listen` in local development.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Admin. The today-view can reveal entry codes, so this must be set
# before deploying — the page refuses to render without it.
# ---------------------------------------------------------------
ADMIN_PASSWORD=

# Protects the daily cron endpoint. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# ---------------------------------------------------------------
# Public site config.
#
# Both domains are ours, and they do different jobs:
#
#   homewickcleaning.com  email only, on Google Workspace
#   homewickcleaning.net  the website, served by Vercel
#
# So the contact address is info@homewickcleaning.com while the site
# lives at www.homewickcleaning.net. That split is deliberate, not a
# mistake — do not "fix" one to match the other. The .net carries no MX
# records and the .com carries no website.
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.homewickcleaning.net
NEXT_PUBLIC_CONTACT_EMAIL=info@homewickcleaning.com
NEXT_PUBLIC_CONTACT_PHONE=

# ---------------------------------------------------------------
# Email — sign-in links for member accounts.
#
# Without these, links are written to the server log instead of sent,
# and `npm run member:link -- someone@example.com` prints one directly.
#
# EMAIL_FROM must be on a domain verified in Resend. Verify a SUBDOMAIN
# of the .net — send.homewickcleaning.net — not either root domain:
#
#   - The .net root has no mail records at all, so a subdomain there
#     cannot disturb anything.
#   - The .com root carries Google Workspace MX and SPF. A domain may
#     have only one SPF record, so adding Resend's to it means editing
#     the record Google relies on. Get that wrong and real company
#     email starts failing.
#   - Sending from the same registrable domain that serves the links
#     also reads better to spam filters than a mismatch.
#
# Send from noreply@ and set no reply-to header. These are one-way
# notifications, not a support channel, and the message says so. Do not
# point replies at info@homewickcleaning.com — that inbox is not staffed
# for it, and a reply that is silently ignored is worse than one the
# customer knows was never delivered.
# ---------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Homewick Cleaning <noreply@send.homewickcleaning.net>"

# Where customers are pointed to leave a public review, shown to everyone
# after they give feedback whatever they scored. Unset until a Google
# Business Profile exists, and the thank you page simply omits it.
NEXT_PUBLIC_REVIEW_URL=

# ---------------------------------------------------------------
# Operator alerts.
#
# Where a "new paid booking" email goes. Server-side only and not
# NEXT_PUBLIC: this address runs the business, it is not a customer
# contact, and it should never reach the browser bundle.
#
# Unset means no alerts are sent and nothing errors, which is the
# right behaviour for a preview deployment.
# ---------------------------------------------------------------
OWNER_ALERT_EMAIL=

# ---------------------------------------------------------------
# Database certificate.
#
# Supabase signs with its own root rather than a public one, so the
# system trust store cannot verify it and the connection is encrypted
# but unauthenticated. That stops passive eavesdropping but not an
# attacker who can answer in Postgres's place: they would receive the
# database password in the handshake and could then read and rewrite
# every row.
#
# Paste the certificate here to close that. Supabase dashboard,
# Settings, Database, SSL configuration, download the certificate,
# then paste its contents as one value including the BEGIN and END
# lines.
#
# Unset means the old behaviour continues and a warning is logged,
# because refusing to connect would take the site down over it.
# ---------------------------------------------------------------
DATABASE_CA_CERT=

# ---------------------------------------------------------------
# Postal address, shown in email footers.
#
# Required on commercial email under CAN-SPAM, and a metro area is
# not an address. Harmless on transactional mail and awkward to be
# missing if a regulator asks, so it appears on everything.
#
# A registered agent address or a PO Box is fine. Unset simply omits
# the line, because an invented address would be worse than none.
# ---------------------------------------------------------------
BUSINESS_POSTAL_ADDRESS=
