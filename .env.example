# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------
# Database — Supabase.
#
# Use the POOLED connection string, not the direct one. This is not a
# preference: Supabase's direct host (db.<ref>.supabase.co) publishes only an
# AAAA record, and Vercel's functions do not route IPv6, so the direct string
# cannot connect from production at all. It also opens one Postgres connection
# per function invocation, which exhausts the server under any real traffic.
#
# The pooled string is in Supabase under Project Settings → Database →
# Connection string → Transaction pooler. Note the username carries the
# project ref, and the port is 6543 rather than 5432:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# For this project the host is aws-0-ca-central-1.pooler.supabase.com.
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Entry-code encryption.
#
# This key decrypts customers' door and gate codes. It lives here,
# outside the database, so that a Postgres dump on its own does not
# open anybody's front door. Generate with:
#
#   openssl rand -base64 32
#
# Rotating it makes existing entry codes unreadable — they would need
# re-encrypting first.
# ---------------------------------------------------------------
ACCESS_SECRET_KEY=

# ---------------------------------------------------------------
# Stripe. Card data never touches our servers; Checkout collects it.
# The webhook secret comes from the endpoint you register in Stripe,
# or from `stripe listen` in local development.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Admin. The today-view can reveal entry codes, so this must be set
# before deploying — the page refuses to render without it.
# ---------------------------------------------------------------
ADMIN_PASSWORD=

# Protects the daily cron endpoint. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# ---------------------------------------------------------------
# Public site config.
#
# The domain is homewickcleaning.NET. The .com is a different business
# — it resolves to a live site on Squarespace with Google Workspace
# mail — so anything sent to info@homewickcleaning.com reaches a
# stranger, not us.
#
# NEXT_PUBLIC_CONTACT_EMAIL stays empty until the .net has MX records.
# It has none today, so mail to info@homewickcleaning.net would bounce,
# and publishing an address that silently drops enquiries is worse than
# publishing none. The footer omits contact details while it is unset.
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
